generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity / Auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  nickname     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Subscription / Premium
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?

  crystals Int @default(50)

  sessions           Session[]
  pets               Pet[]
  subscriptionEvents SubscriptionEvent[]

  @@index([nickname])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model SubscriptionEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "activated" | "deactivated"
  source    String // "admin" | "system"
  until     DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Pet
// ---------------------------------------------------------------------------

enum WorldTheme {
  FANTASY
  SPACE
  CYBERPUNK
}

model Pet {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  world  WorldTheme

  // Stats, 0-100
  trust        Int @default(50)
  intelligence Int @default(10)
  strength     Int @default(10)
  energy       Int @default(80)
  hunger       Int @default(70)

  // Personality trait vector, values 0-1, sums roughly to 1 across the set.
  // e.g. { "curious": 0.6, "lazy": 0.2, "aggressive": 0.1, "gentle": 0.1 }
  personality Json

  stage    Int      @default(0) // evolution stage index
  bornAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  lastFedAt  DateTime?
  neglected  Boolean  @default(false) // true once trust has bottomed out; can be rescued

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ChatRole {
  USER
  PET
}

model ChatMessage {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

// Server-side daily free-message counter (defense in depth for the AI chat
// rate limit — free users get a small number of pet replies per day).
model ChatCounter {
  id     String   @id @default(cuid())
  userId String
  day    DateTime // truncated to UTC date
  count  Int      @default(0)

  @@unique([userId, day])
}
