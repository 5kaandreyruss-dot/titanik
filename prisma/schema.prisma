generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity / Auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  nickname     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Subscription / Premium (spec #32, #69)
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?

  sessions            Session[]
  gameRuns            GameRun[]
  playerAchievements  PlayerAchievement[]
  discoveries         Discovery[]
  leaderboardEntries  LeaderboardEntry[]
  subscriptionEvents  SubscriptionEvent[]
  analyticsEvents     AnalyticsEvent[]

  @@index([nickname])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model SubscriptionEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "activated" | "deactivated"
  source    String // "admin" | "system"
  until     DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Game Runs
// ---------------------------------------------------------------------------

enum GameRunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

model GameRun {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    GameRunStatus @default(ACTIVE)
  seed      String
  archetypeId String

  // Full serialized GameRunState (see ARCHITECTURE.md / GAME_DESIGN.md)
  stateJson Json

  actionCount Int      @default(0)
  endingId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  finishedAt  DateTime?

  discoveries        Discovery[]
  leaderboardEntry   LeaderboardEntry?
  playerAchievements PlayerAchievement[]
  analyticsEvents    AnalyticsEvent[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

// Server-side free-run daily counter (defense in depth alongside the
// GameRun.createdAt count check — kept for fast lookups / potential future
// non-run-based limits).
model RunCounter {
  id       String   @id @default(cuid())
  userId   String
  day      DateTime // truncated to UTC date
  count    Int      @default(0)

  @@unique([userId, day])
}

// ---------------------------------------------------------------------------
// Knowledge Archive (per-account meta knowledge, spec #19)
// ---------------------------------------------------------------------------

model Discovery {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRunId   String?
  gameRun     GameRun? @relation(fields: [gameRunId], references: [id], onDelete: SetNull)
  knowledgeId String // matches a content-defined knowledge entry id
  category    String // People | Locations | Events | Secrets | Technical | Endings
  discoveredAt DateTime @default(now())

  @@unique([userId, knowledgeId])
  @@index([userId, category])
}

// ---------------------------------------------------------------------------
// Achievements (spec #28)
// ---------------------------------------------------------------------------

model Achievement {
  id          String @id // stable string id, matches lib/content/achievements
  name        String
  description String
  secret      Boolean @default(false)

  playerAchievements PlayerAchievement[]
}

model PlayerAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  gameRunId     String?
  gameRun       GameRun?    @relation(fields: [gameRunId], references: [id], onDelete: SetNull)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Leaderboards (spec #29) — materialized per finished run for fast queries
// ---------------------------------------------------------------------------

model LeaderboardEntry {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRunId          String   @unique
  gameRun            GameRun  @relation(fields: [gameRunId], references: [id], onDelete: Cascade)
  nickname           String // denormalized for fast leaderboard reads
  peopleRescued      Int      @default(0)
  explorationPercent Int      @default(0)
  secretsDiscovered  Int      @default(0)
  survived           Boolean  @default(false)
  heroicEnding       Boolean  @default(false)
  durationMinutes    Int      @default(0) // real-world seconds elapsed during run, for speed board
  achievementsCount  Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([peopleRescued])
  @@index([explorationPercent])
  @@index([secretsDiscovered])
  @@index([durationMinutes])
  @@index([achievementsCount])
}

// ---------------------------------------------------------------------------
// Content catalog mirrors (admin/reporting only — gameplay reads lib/content)
// ---------------------------------------------------------------------------

model NpcDefinitionRow {
  id      String @id
  name    String
  version Int    @default(1)
}

model LocationDefinitionRow {
  id      String @id
  name    String
  version Int    @default(1)
}

model ItemDefinitionRow {
  id      String @id
  name    String
  version Int    @default(1)
}

model EventDefinitionRow {
  id      String @id
  name    String
  version Int    @default(1)
}

model EndingDefinitionRow {
  id      String @id
  name    String
  version Int    @default(1)
}

// ---------------------------------------------------------------------------
// Analytics (spec #71 — architecture only, minimal)
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  gameRunId String?
  gameRun   GameRun? @relation(fields: [gameRunId], references: [id], onDelete: SetNull)
  type      String // "run_started" | "run_completed" | "ending_reached" | ...
  payload   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
